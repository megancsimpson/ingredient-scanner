# Where the app sends its requests. Use one of these (put # in front of the other).
# Expo only reads this file when it starts: restart with `npx expo start --clear` after changing it.

# The API running on your computer (`npm run dev` in backend). Your phone must be on the
# same Wi-Fi. Find your computer's address with `ipconfig getifaddr en0` (Mac).
EXPO_PUBLIC_API_URL=http://YOUR-COMPUTER-IP:3000

# The live API on Render: https, no port, no slash at the end
# EXPO_PUBLIC_API_URL=https://YOUR-SERVICE-NAME.onrender.com
