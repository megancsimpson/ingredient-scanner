MONGODB_URI=your-mongodb-connection-string
PORT=3000
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-long-random-secret
GOOGLE_VISION_API_KEY=your-google-vision-api-key
# Gmail account that sends "forgot password" codes. EMAIL_APP_PASSWORD is a
# Google app password (needs 2-Step Verification), not the normal password:
#   https://myaccount.google.com/apppasswords
EMAIL_USER=your-app-account@gmail.com
EMAIL_APP_PASSWORD=your-16-letter-app-password
# Only on Render (leave unset locally): how many proxies sit in front of the
# server, so rate limits see each user's real IP address. See the README's
# Deployment section for how to find the number.
# TRUST_PROXY_HOPS=1
